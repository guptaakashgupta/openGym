{
  "client": "pilot-current",
  "description": "What the current pilot client sends and reads: personal sync with fields this server does not know, which are kept whole.",
  "requests": [
    { "as": "member", "method": "PUT", "path": "/api/data", "body": { "state": { "workouts": [{ "id": "cw1", "d": "2026-10-20", "entries": [{ "id": "0025", "sets": [{ "w": 60, "r": 5, "done": true }] }] }], "futureClientField": { "kept": true } }, "stamped": true }, "status": 200, "keys": ["rev"] },
    { "as": "member", "method": "GET", "path": "/api/data", "status": 200, "keys": ["state"], "keepsField": "futureClientField" },

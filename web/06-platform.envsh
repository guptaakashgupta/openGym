#!/bin/sh
# Sourced by nginx's entrypoint, before envsubst. Opt in on non-Compose hosts.
if [ "${RESOLVER:-}" = system ]; then
  RESOLVER=$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ { print $2; exit }' /etc/resolv.conf)
  if [ -z "$RESOLVER" ]; then
    echo "No IPv4 nameserver in /etc/resolv.conf" >&2
    exit 1
  fi
  export RESOLVER
  # nginx's async resolver does not apply resolv.conf search domains. Render
  # supplies a short private service name that libc resolves with this suffix.
  case "${BACKEND:-}" in
    ""|*.*|*:*) ;;
    *)
      search_domain=$(awk '$1 == "search" { print $2; exit }' /etc/resolv.conf)
      if [ -n "$search_domain" ]; then
        BACKEND="$BACKEND.$search_domain"
        export BACKEND
      fi
      ;;
  esac
fi

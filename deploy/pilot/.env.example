# Non-secret settings for deploy/pilot/compose.yml. Copy to .env per environment. Placeholders only.
PILOT_ENV=staging
# The exact hostname: passkeys are bound to it (RP_ID). Changing it later needs re-enrolment.
PILOT_DOMAIN=gym.example.com
ACME_EMAIL=ops@example.com
# Pin images by digest, from the release manifest (docs/ops/PILOT_RELEASE_MANIFEST.example.json).
API_IMAGE=registry.example.com/gympilot/api@sha256:<digest>
WEB_IMAGE=registry.example.com/gympilot/web@sha256:<digest>
# Path to the secrets file this host receives from the secret manager (never committed). It holds:
#   DATABASE_URL=postgres://<user>:<password>@<managed-host>:5432/<db>?sslmode=verify-full
#   SESSION_SECRET=<at least 32 random characters>
SECRETS_FILE=/run/gympilot/secrets.env
# The platform operator account id(s): account recovery only.
ADMIN_UIDS=
AUDIT_DAYS=90
VAPID_SUBJECT=mailto:ops@example.com
